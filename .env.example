# Copie para .env e ajuste. NUNCA commite o .env.
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Produção: postgresql+asyncpg://usuario:senha@host:5432/banco
JWT_SECRET=troque-por-uma-chave-aleatoria-com-mais-de-32-caracteres

# true = libera compra de plano simulada, número de teste e simulador de cliente.
# Em produção com clientes reais, use false.
TEST_MODE=true

# Número real (API oficial da Meta). O token de verificação é um texto secreto que VOCÊ escolhe e
# informa também no painel da Meta (configuração do webhook).
WHATSAPP_VERIFY_TOKEN=escolha-um-texto-secreto-longo
# Segredo do app Meta (Configurações do app > Básico). Quando preenchido, o webhook valida a assinatura.
WHATSAPP_APP_SECRET=

# Fase 3 (IA)
ANTHROPIC_API_KEY=
