# Copie para .env e ajuste. NUNCA commite o .env.
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Produção: postgresql+asyncpg://usuario:senha@host:5432/banco
JWT_SECRET=troque-por-uma-chave-aleatoria-com-mais-de-32-caracteres

# mock = simulado (sem WhatsApp real) | whatsapp = Cloud API oficial da Meta
CHANNEL_PROVIDER=mock

# Preencher quando tiver a conta Meta (ver README, seção "Contas necessárias")
WHATSAPP_VERIFY_TOKEN=escolha-um-texto-secreto
WHATSAPP_APP_SECRET=

# Fase 3 (IA)
ANTHROPIC_API_KEY=
